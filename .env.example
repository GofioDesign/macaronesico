# Copia este archivo como .env para trabajar en local.
# En producción, estas variables se definen en Cloudflare Pages
# (Settings → Variables and secrets), tanto para Production como para Preview.

# Sin esta variable, el gestor en local edita los archivos del disco.
# Con "github", edita el repositorio directamente (igual que en producción).
# PUBLIC_KEYSTATIC_MODO=github

# Datos de la GitHub App del gestor (ver docs/puesta-en-marcha.md)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
