---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { IDIOMAS, SITIO, type Idioma } from '../lib/sitio';
import { t } from '../i18n/textos';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: ImageMetadata | null;
  imagenAlt?: string;
  tipo?: 'website' | 'article';
  idioma?: Idioma;
  /** Versiones de la misma página en otros idiomas */
  alternos?: { idioma: Idioma; url: string }[];
  jsonld?: object | object[];
  noindex?: boolean;
  publicado?: Date;
  modificado?: Date | null;
  rss?: { titulo: string; url: string };
}

const {
  titulo,
  descripcion = SITIO.descripcion,
  imagen,
  imagenAlt = '',
  tipo = 'website',
  idioma = 'es',
  alternos = [],
  jsonld,
  noindex = false,
  publicado,
  modificado,
  rss,
} = Astro.props;

const tituloCompleto = titulo ? `${titulo} · ${SITIO.nombre}` : `${SITIO.nombre} · ${SITIO.lema}`;
const canonica = new URL(Astro.url.pathname, Astro.site).href;

let imagenSocial = new URL('/og.png', Astro.site).href;
if (imagen) {
  const optimizada = await getImage({ src: imagen, width: 1200, format: 'jpeg', quality: 80 });
  imagenSocial = new URL(optimizada.src, Astro.site).href;
}

const organizacion = {
  '@type': 'Organization',
  '@id': `${SITIO.url}/#organizacion`,
  name: SITIO.nombre,
  url: `${SITIO.url}/`,
  description: SITIO.descripcion,
  logo: { '@type': 'ImageObject', url: `${SITIO.url}/icono-512.png`, width: 512, height: 512 },
  parentOrganization: { '@type': 'Organization', name: SITIO.administra.nombre, url: SITIO.administra.url },
};
const bloquesJsonld = [
  organizacion,
  {
    '@type': 'WebSite',
    '@id': `${SITIO.url}/#web`,
    url: `${SITIO.url}/`,
    name: SITIO.nombre,
    inLanguage: 'es',
    publisher: { '@id': `${SITIO.url}/#organizacion` },
  },
  ...(Array.isArray(jsonld) ? jsonld : jsonld ? [jsonld] : []),
];
const grafo = JSON.stringify({ '@context': 'https://schema.org', '@graph': bloquesJsonld });
const textos = t(idioma);
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      alternos.length > 1 &&
        alternos.map((a) => <link rel="alternate" hreflang={a.idioma} href={new URL(a.url, Astro.site).href} />)
    }
    {
      alternos.length > 1 && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL((alternos.find((a) => a.idioma === 'es') ?? alternos[0]).url, Astro.site).href}
        />
      )
    }

    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:locale" content={IDIOMAS[idioma].locale.replace('-', '_')} />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo ?? SITIO.nombre} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenSocial} />
    {imagenAlt && <meta property="og:image:alt" content={imagenAlt} />}
    {publicado && <meta property="article:published_time" content={publicado.toISOString()} />}
    {modificado && <meta property="article:modified_time" content={modificado.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icono-512.png" />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161514" media="(prefers-color-scheme: dark)" />

    <link rel="alternate" type="application/rss+xml" title={`${SITIO.nombre}: todos los artículos`} href="/feed.xml" />
    {rss && <link rel="alternate" type="application/rss+xml" title={rss.titulo} href={rss.url} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={grafo} />

    <!-- Cloudflare Web Analytics (sin cookies). Se activa desde el panel de Cloudflare Pages. -->
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">{textos.saltar}</a>
    <Cabecera idioma={idioma} />
    <main id="contenido">
      <slot />
    </main>
    <Pie idioma={idioma} />
  </body>
</html>
