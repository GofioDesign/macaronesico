---
/** Versión portátil del explorador: sin JavaScript, remite al original. */
import { cargarDatos } from '../../lib/datos';
import { SITIO } from '../../lib/sitio';
const { datos, titulo } = Astro.props;
const { meta } = await cargarDatos(datos);
---

<p>
  <em>
    {titulo ? `${titulo}: ` : ''}gráfico interactivo disponible en el artículo original de {SITIO.nombre}. Datos:
    <a href={`${SITIO.url}/datos/${meta.id}/`}>{meta.data.titulo}</a>.
  </em>
</p>
