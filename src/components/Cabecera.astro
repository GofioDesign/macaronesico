---
import { CATEGORIAS, IDIOMAS, SITIO, type Idioma } from '../lib/sitio';
import { t } from '../i18n/textos';
import Logo from './Logo.astro';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const textos = t(idioma);
const ruta = Astro.url.pathname;
const inicio = `${IDIOMAS[idioma].prefijo}/`;
const enlaces = [
  ...Object.entries(CATEGORIAS).map(([clave, c]) => ({ href: `/${clave}/`, texto: c.nombre })),
  { href: '/biblioteca/', texto: textos.biblioteca },
  { href: '/datos/', texto: textos.datos },
];
---

<header class="cabecera">
  <div class="contenedor fila">
    <a class="marca" href={inicio} aria-label={`${SITIO.nombre}, ${textos.inicio.toLowerCase()}`}>
      <Logo class="logo" />
    </a>
    <p class="lema">{SITIO.lema}</p>
  </div>
  <nav class="contenedor" aria-label="Secciones">
    <ul>
      {
        enlaces.map((e) => (
          <li>
            <a href={e.href} aria-current={ruta.startsWith(e.href) ? 'page' : undefined}>
              {e.texto}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .cabecera {
    border-bottom: 1px solid var(--linea);
    padding-top: 1.25rem;
  }
  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--tinta);
  }
  .logo {
    display: block;
    height: clamp(2.2rem, 1.8rem + 1.5vw, 2.9rem);
    width: auto;
  }
  .lema {
    margin: 0;
    font-family: var(--sans);
    font-size: 0.875rem;
    color: var(--tinta-3);
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: 0.25rem 1.5rem;
    padding: 0;
    margin: 0.9rem 0 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav a {
    display: inline-block;
    padding: 0.55rem 0 0.7rem;
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--tinta-2);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--tinta);
    border-bottom-color: var(--acento);
  }
</style>
