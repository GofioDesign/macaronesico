---
/**
 * Gráfico en HTML y CSS, generado en la compilación: se lee sin JavaScript,
 * las etiquetas largas se ajustan solas y respeta el modo oscuro.
 *  - "puntos": dos grupos enfrentados por fila, con la diferencia a la derecha.
 *  - "barras": una o dos series en barras horizontales.
 */
import { cargarDatos, esNumero, formatoNumero, listaColumnas, ordenarFilas } from '../../lib/datos';

interface Props {
  datos: string;
  tipo?: 'puntos' | 'barras';
  titulo?: string;
  etiqueta?: string;
  series?: string;
  orden?: string;
  unidad?: string;
  pie?: string;
}

const { datos, tipo = 'puntos', titulo, etiqueta, series, orden, unidad = '%', pie } = Astro.props;
const { meta, tabla } = await cargarDatos(datos);

const colEtiqueta = etiqueta && tabla.columnas.includes(etiqueta) ? etiqueta : tabla.columnas[0];
const pedidas = listaColumnas(series).filter((c) => tabla.columnas.includes(c));
const numericas = tabla.columnas.filter((c) => c !== colEtiqueta && tabla.filas.every((f) => esNumero(f[c])));
const cols = (pedidas.length ? pedidas : numericas).slice(0, 2);

if (cols.length === 0) {
  throw new Error(`[macaronesico] El gráfico de "${datos}" no encuentra columnas numéricas que representar.`);
}
const modo = tipo === 'puntos' && cols.length === 2 ? 'puntos' : 'barras';

const filas = ordenarFilas(tabla, orden);
const valores = filas.flatMap((f) => cols.map((c) => Number(f[c])));
const maximo = Math.max(...valores, 0);
const escalaMax = unidad === '%' && maximo <= 100 ? 100 : Math.ceil(maximo / 10) * 10 || 1;
const marcas = [0, 0.25, 0.5, 0.75, 1].map((p) => Math.round(escalaMax * p));
const pos = (v: number) => `${((v / escalaMax) * 100).toFixed(2)}%`;
const fmt = (v: string, signo = false) => `${formatoNumero(v, 'es-ES', signo)}${unidad === '%' ? '' : ' '}${unidad}`;
const diferencia = (f: Record<string, string>) => {
  const d = Number(f[cols[0]]) - Number(f[cols[1]]);
  return (Math.round(d * 10) / 10).toFixed(1);
};
---

<figure class:list={['grafico', 'amplio', `grafico-${modo}`]}>
  {titulo && <figcaption class="titulo">{titulo}</figcaption>}

  <ul class="leyenda" aria-label="Leyenda">
    {
      cols.map((c, i) => (
        <li>
          <span class:list={['muestra', `s${i + 1}`]} aria-hidden="true" />
          {c}
        </li>
      ))
    }
    {modo === 'puntos' && <li class="nota-dif">Diferencia en puntos a la derecha</li>}
  </ul>

  <div class="cuerpo" role="img" aria-label={`${titulo ?? meta.data.titulo}. Los valores están en la tabla de datos.`}>
    <div class="fila eje" aria-hidden="true">
      <span class="et" />
      <span class="pista">
        {
          marcas.map((m) => (
            <span class="marca" style={`left:${pos(m)}`}>
              {m}
              {unidad === '%' ? '%' : ''}
            </span>
          ))
        }
      </span>
      {modo === 'puntos' && <span class="dif" />}
    </div>

    <ol class="filas">
      {
        filas.map((f) => {
          const a = Number(f[cols[0]]);
          const b = Number(f[cols[1]] ?? 0);
          return (
            <li class="fila">
              <span class="et">{f[colEtiqueta]}</span>
              <span class="pista">
                {marcas.map((m) => (
                  <span class="guia" style={`left:${pos(m)}`} aria-hidden="true" />
                ))}
                {modo === 'puntos' ? (
                  <>
                    <span class="tramo" style={`left:${pos(Math.min(a, b))};width:${pos(Math.abs(a - b))}`} />
                    {cols.map((c, i) => (
                      <span
                        class:list={['punto', `s${i + 1}`]}
                        style={`left:${pos(Number(f[c]))}`}
                        tabindex="0"
                        data-valor={`${c}: ${fmt(f[c])}`}
                        aria-label={`${f[colEtiqueta]}. ${c}: ${fmt(f[c])}`}
                      />
                    ))}
                  </>
                ) : (
                  <span class="barras">
                    {cols.map((c, i) => (
                      <span class="barra-fila">
                        <span
                          class:list={['barra', `s${i + 1}`]}
                          style={`width:${pos(Number(f[c]))}`}
                          tabindex="0"
                          data-valor={`${c}: ${fmt(f[c])}`}
                          aria-label={`${f[colEtiqueta]}. ${c}: ${fmt(f[c])}`}
                        />
                        <span class="valor">{fmt(f[c])}</span>
                      </span>
                    ))}
                  </span>
                )}
              </span>
              {modo === 'puntos' && <span class="dif">{formatoNumero(diferencia(f), 'es-ES', true)}</span>}
            </li>
          );
        })
      }
    </ol>
  </div>

  <p class="pie">
    {pie && <span>{pie} </span>}
    <a href={`/datos/${meta.id}/`}>Ver los datos</a>
  </p>
</figure>

<style>
  .grafico {
    margin-block: 2.5rem !important;
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--tinta-2);
  }
  .titulo {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--tinta);
    margin-bottom: 0.75rem;
  }
  .leyenda {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    padding: 0;
    margin: 0 0 1rem;
    color: var(--tinta);
  }
  .leyenda li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .leyenda .nota-dif {
    color: var(--tinta-3);
  }
  .muestra {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
  }
  .grafico-barras .muestra {
    border-radius: 2px;
  }
  .s1 {
    background: var(--serie-1);
  }
  .s2 {
    background: var(--serie-2);
  }

  .filas {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .fila {
    display: grid;
    grid-template-columns: minmax(10rem, 38%) 1fr 3.5rem;
    gap: 0.25rem 1rem;
    align-items: center;
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--linea);
  }
  .grafico-barras .fila {
    grid-template-columns: minmax(10rem, 38%) 1fr;
  }
  .fila.eje {
    border-bottom: 0;
    padding-bottom: 0.2rem;
  }
  .et {
    line-height: 1.3;
    color: var(--tinta);
  }
  .pista {
    position: relative;
    min-height: 1.4rem;
    margin-right: 1.2rem;
  }
  .marca {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-size: 0.75rem;
    color: var(--tinta-3);
    font-variant-numeric: tabular-nums;
  }
  .guia {
    position: absolute;
    top: -0.4rem;
    bottom: -0.4rem;
    width: 1px;
    background: var(--linea);
  }
  .tramo {
    position: absolute;
    top: 50%;
    height: 2px;
    transform: translateY(-50%);
    background: var(--tinta-3);
    opacity: 0.55;
  }
  .punto {
    position: absolute;
    top: 50%;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 2px var(--papel);
    cursor: default;
  }
  .punto::before {
    /* área de interacción mayor que la marca */
    content: '';
    position: absolute;
    inset: -0.5rem;
  }
  .dif {
    text-align: right;
    font-weight: 600;
    color: var(--tinta);
    font-variant-numeric: tabular-nums;
  }

  .barras {
    display: grid;
    gap: 2px;
  }
  .barra-fila {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .barra {
    display: block;
    height: 0.7rem;
    border-radius: 0 4px 4px 0;
    min-width: 1px;
  }
  .valor {
    font-size: 0.75rem;
    color: var(--tinta-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Tooltip */
  .punto::after,
  .barra::after {
    content: attr(data-valor);
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
    padding: 0.3rem 0.5rem;
    border-radius: var(--radio);
    background: var(--tinta);
    color: var(--papel);
    font-size: 0.75rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.12s;
    z-index: 2;
  }
  .barra {
    position: relative;
  }
  .barra::after {
    left: 100%;
  }
  .punto:hover::after,
  .punto:focus-visible::after,
  .barra:hover::after,
  .barra:focus-visible::after {
    opacity: 1;
  }

  .pie {
    margin: 0.75rem 0 0;
    font-size: 0.8rem;
    color: var(--tinta-3);
  }

  @media (max-width: 40rem) {
    .fila {
      grid-template-columns: 1fr 3rem;
    }
    .grafico-barras .fila {
      grid-template-columns: 1fr;
    }
    .et {
      grid-column: 1 / -1;
    }
    .fila.eje .et {
      display: none;
    }
    .grafico-barras .fila.eje .pista {
      grid-column: 1;
    }
  }
</style>
